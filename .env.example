PORT=3000
NODE_ENV=development
GEMINI_API_KEY=

# Required only for /admin login (at least 12 characters).
ADMIN_PASSWORD=
# Use a persistent volume path in production.
CONTENT_DATA_DIR=.local/content

ADMIN_USERNAME=admin
# Non-production testing only: enables a test login when ADMIN_PASSWORD is empty.
# Ignored entirely when NODE_ENV=production.
ADMIN_TEST_LOGIN=false

# Comma-separated exact public origins (no trailing /) for public content CORS/embedding.
# Admin/auth/source APIs always remain same-origin.
PUBLIC_SITE_ORIGINS=https://areva-paint-new.onrender.com,https://areva-paint-new-admin.onrender.com
# Shared image/PDF upload budget. Full storage refuses new uploads without deleting files.
UPLOAD_STORAGE_MB=512
# Use 0 when serving directly; Render uses 1 trusted proxy hop.
TRUST_PROXY_HOPS=0
